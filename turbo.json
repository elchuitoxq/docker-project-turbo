{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "CI"],
  "globalDependencies": ["tsconfig.base.json", "pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "NEXT_OUTPUT", "NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:generate": {
      "inputs": ["src/**/*", "drizzle.config.ts"],
      "outputs": ["drizzle/**"],
      "cache": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed:test": {
      "cache": false
    },
    "test:db:prepare": {
      "cache": false
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": []
    },
    "test:coverage": {
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    }
  }
}
