{
  "name": "@mi-monorepo/shared-types",
  "version": "1.0.0",
  "private": true,
  "description": "Tipos TypeScript generados desde el OpenAPI del backend",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "sync": "node ./scripts/sync.mjs",
    "generate": "openapi-typescript ../../apps/backend/docs/openapi.json -o src/api-types.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
