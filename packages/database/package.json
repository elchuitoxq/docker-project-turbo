{
  "name": "database",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db:prepare": "tsx src/scripts/prepare-test-databases.ts",
    "db:studio": "drizzle-kit studio --host 127.0.0.1 --port 4983",
    "db:studio:docker": "drizzle-kit studio --host 0.0.0.0 --port 4983",
    "db:seed": "tsx src/scripts/run-seed.ts test",
    "db:seed:core": "tsx src/scripts/run-seed.ts core",
    "db:seed:dev": "tsx src/scripts/run-seed.ts dev",
    "db:seed:faker": "tsx src/scripts/run-seed.ts faker",
    "db:seed:prod": "tsx src/scripts/run-seed.ts prod",
    "db:seed:test": "tsx src/scripts/run-seed.ts test",
    "db:reset": "tsx src/scripts/reset.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.20.5",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
