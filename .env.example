DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydb?schema=public
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=7d
PORT=4000
BCV_API_URL=https://www.bcv.org.ve/seccionportal/tipo-de-cambio-oficial-del-bcv

# Sincronización automática de la tasa oficial (cron 09:00 y 17:00, hora de Caracas, de lunes a viernes)
EXCHANGE_RATE_SYNC_ENABLED=true
# Bloqueo automático de lotes vencidos (cron 00:05, hora de Caracas)
INVENTORY_EXPIRY_BLOCK_ENABLED=true
# Horas tras las que la tasa se considera vencida y la emisión pide confirmación
EXCHANGE_RATE_MAX_AGE_HOURS=24
# Desvío máximo aceptado en una sincronización automática (un override manual con motivo no lo usa)
EXCHANGE_RATE_MAX_VARIATION_PCT=20

# CORS (lista separada por comas)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Recuperaci�n de contrase�a (en dev el enlace se escribe en el log)
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# En producci�n hace falta un proveedor de correo (pendiente de integraci�n)
SMTP_URL=

# Swagger en producci�n (por defecto deshabilitado)
ENABLE_SWAGGER=false