DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydb?schema=public
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=7d
PORT=4000
BCV_API_URL=https://www.bcv.org.ve

# CORS (lista separada por comas)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Recuperación de contraseña (en dev el enlace se escribe en el log)
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# En producción hace falta un proveedor de correo (pendiente de integración)
SMTP_URL=

# Swagger en producción (por defecto deshabilitado)
ENABLE_SWAGGER=false