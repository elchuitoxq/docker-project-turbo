{
  "name": "mi-monorepo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^1.20.9",
      "js-yaml": "^4.3.2",
      "lodash": "^4.18.0",
      "multer": "^2.3.0",
      "qs": "^6.16.1",
      "esbuild@<0.25.0": "^0.25.12",
      "uuid@<11.1.1": "^11.1.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "core-js",
      "esbuild",
      "msw",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter backend dev",
    "dev:devtools": "pnpm --filter backend dev:tools",
    "dev:mock": "pnpm --filter backend mock",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:db": "pnpm --filter database db:studio",
    "dev:docker:up": "docker compose up -d",
    "dev:docker:tools": "docker compose --profile tools up -d",
    "dev:docker:watch": "docker compose watch",
    "dev:docker:build": "docker compose up --build",
    "dev:docker:down": "docker compose down",
    "dev:docker:logs": "docker compose logs -f",
    "dev:docker:ps": "docker compose ps",
    "openapi:export": "pnpm --filter backend openapi:export",
    "sync:types": "pnpm --filter @mi-monorepo/shared-types sync",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" \"!**/node_modules/**\" \"!**/dist/**\" \"!**/.next/**\" \"!**/coverage/**\" \"!**/.turbo/**\" \"!packages/database/drizzle/**\" \"!packages/shared-types/src/api-types.ts\" \"!packages/shared-types/openapi.json\" \"!apps/backend/docs/openapi.json\" \"!apps/frontend/next-env.d.ts\" \"!test-results/**\" \"!playwright-report/**\" \"!audit-report/**\" \"!graphify-out/**\" \"!.agents/**\" \"!.opencode/**\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" \"!**/node_modules/**\" \"!**/dist/**\" \"!**/.next/**\" \"!**/coverage/**\" \"!**/.turbo/**\" \"!packages/database/drizzle/**\" \"!packages/shared-types/src/api-types.ts\" \"!packages/shared-types/openapi.json\" \"!apps/backend/docs/openapi.json\" \"!apps/frontend/next-env.d.ts\" \"!test-results/**\" \"!playwright-report/**\" \"!audit-report/**\" \"!graphify-out/**\" \"!.agents/**\" \"!.opencode/**\"",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed:test": "turbo run db:seed:test",
    "test:db:prepare": "turbo run test:db:prepare",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
