{
  "name": "mi-monorepo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "body-parser": "^1.20.9",
      "js-yaml": "^4.3.2",
      "lodash": "^4.18.0",
      "multer": "^2.3.0",
      "qs": "^6.16.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "core-js",
      "esbuild",
      "msw",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter backend dev",
    "dev:devtools": "pnpm --filter backend dev:tools",
    "dev:mock": "pnpm --filter backend mock",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:db": "pnpm --filter database db:studio",
    "dev:docker:up": "docker compose up",
    "dev:docker:build": "docker compose up --build",
    "dev:docker:down": "docker compose down",
    "dev:docker:logs": "docker compose logs -f",
    "dev:docker:ps": "docker compose ps",
    "openapi:export": "pnpm --filter backend openapi:export",
    "sync:types": "pnpm --filter @mi-monorepo/shared-types sync",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed:test": "turbo run db:seed:test",
    "test:db:prepare": "turbo run test:db:prepare",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
